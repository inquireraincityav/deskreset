{
  "name": "desk-reset",
  "version": "0.1.0",
  "description": "Local, private eye/stretch/water break reminder for desk workers. Mac first.",
  "private": true,
  "main": "out/main/index.js",
  "author": "Desk Reset",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack:mac": "npm run build && electron-builder --mac --universal",
    "pack:mac-arm": "npm run build && electron-builder --mac --arm64",
    "pack:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.5",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "dependencies": {}
}
